        "def generate_from_noise(initial_noise, diffusion_steps, return_trajectory=False):\n",
        "    # Igual que model.generate, pero partiendo de un ruido dado y (opcional) guardando cada paso\n",
        "    noisy_images = initial_noise\n",
        "    num_images = initial_noise.shape[0]\n",
        "    step_size = 1.0 / diffusion_steps\n",
        "    traj_noisy, traj_pred = [], []\n",
        "    for step in range(diffusion_steps):\n",
        "        diffusion_times = ops.ones((num_images, 1, 1, 1)) - step * step_size\n",
        "        noise_rates, signal_rates = diffusion_schedule(diffusion_times)\n",
        "        pred_images, pred_noises = model.denoise(noisy_images, noise_rates, signal_rates)\n",
        "        if return_trajectory:\n",
        "            traj_noisy.append(ops.convert_to_numpy(noisy_images))\n",
        "            traj_pred.append(ops.convert_to_numpy(pred_images))\n",
        "        next_noise_rates, next_signal_rates = diffusion_schedule(diffusion_times - step_size)\n",
        "        noisy_images = next_signal_rates * pred_images + next_noise_rates * pred_noises\n",
        "    denorm = lambda x: np.clip(ops.convert_to_numpy(model.normalizer.mean)\n",
        "                               + x * ops.convert_to_numpy(model.normalizer.variance) ** 0.5, 0, 255)\n",
        "    images = denorm(ops.convert_to_numpy(pred_images))\n",
        "    if return_trajectory:\n",
        "        return images, [denorm(x) for x in traj_noisy], [denorm(x) for x in traj_pred]\n",
        "    return images\n",
        "\n",
        "fixed_noise = keras.random.normal((4, image_size, image_size, 3), seed=7)\n",
        "steps_list = [1, 2, 5, 10, 20, 50]\n",
        "cols = []\n",
        "for s in steps_list:\n",
        "    cols.append(generate_from_noise(fixed_noise, s))\n",
        "grid = np.stack(cols, axis=1).reshape(-1, image_size, image_size, 3)   # filas = semillas, columnas = pasos\n",
        "show_images(grid, n_cols=len(steps_list), size=1.8,\n",
        "            titles=[f\"{s} pasos\" for s in steps_list] + [\"\"] * (len(grid) - len(steps_list)),\n",
        "            title=\"Mismo ruido inicial, distinto número de pasos\")"
      ]
