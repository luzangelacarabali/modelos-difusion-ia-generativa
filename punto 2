        "## 4. El modelo de difusión completo\n",
        "\n",
        "La clase `DiffusionModel` envuelve la U-Net y define:\n",
        "\n",
        "- `denoise`: llama a la U-Net para predecir el ruido y, con él, **reconstruye la imagen limpia** despejando $x_0=(x_t-\\text{noise\\_rate}\\cdot\\hat\\varepsilon)/\\text{signal\\_rate}$.\n",
        "- `call` (entrenamiento): normaliza las imágenes, toma ruido y tiempos aleatorios, ensucia las imágenes y pide a la red que prediga el ruido.\n",
        "- `compute_loss`: error absoluto medio (MAE) entre el ruido real y el predicho.\n",
        "- `generate`: parte de ruido puro y, durante `diffusion_steps` pasos, estima la imagen limpia y la **vuelve a ensuciar con un nivel de ruido un poco menor** (muestreo tipo DDIM, determinista). Al final desnormaliza a [0, 255]."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "1a9925e2",
      "metadata": {
        "id": "1a9925e2"
      },
      "outputs": [],
      "source": [
        "class DiffusionModel(keras.Model):\n",
        "    def __init__(self, image_size, widths, block_depth, **kwargs):\n",
        "        super().__init__(**kwargs)\n",
        "        self.image_size = image_size\n",
        "        self.denoising_model = get_model(image_size, widths, block_depth)\n",
        "        self.seed_generator = keras.random.SeedGenerator()\n",
        "        self.loss = keras.losses.MeanAbsoluteError()   # nuestra función de pérdida\n",
        "        self.normalizer = keras.layers.Normalization()  # para normalizar las imágenes de entrada\n",
        "\n",
        "    def denoise(self, noisy_images, noise_rates, signal_rates):\n",
        "        # La U-Net predice el ruido...\n",
        "        pred_noise_masks = self.denoising_model([noisy_images, noise_rates])\n",
        "        # ...y con él reconstruimos la imagen limpia predicha\n",
        "        pred_images = (noisy_images - noise_rates * pred_noise_masks) / signal_rates\n",
        "        return pred_images, pred_noise_masks\n",
        "\n",
        "    def call(self, images):\n",
        "        images = self.normalizer(images)\n",
        "        # Ruido aleatorio\n",
        "        noise_masks = keras.random.normal(\n",
        "            (batch_size, self.image_size, self.image_size, 3), seed=self.seed_generator)\n",
        "        # Tiempos de difusión aleatorios, uno por imagen\n",
        "        diffusion_times = keras.random.uniform(\n",
        "            (batch_size, 1, 1, 1), minval=0.0, maxval=1.0, seed=self.seed_generator)\n",
        "        noise_rates, signal_rates = diffusion_schedule(diffusion_times)\n",
        "        # Ensuciamos las imágenes\n",
        "        noisy_images = signal_rates * images + noise_rates * noise_masks\n",
        "        # Y les quitamos el ruido\n",
        "        pred_images, pred_noise_masks = self.denoise(noisy_images, noise_rates, signal_rates)\n",
        "        return pred_images, pred_noise_masks, noise_masks\n",
        "\n",
        "    def compute_loss(self, x, y, y_pred, sample_weight=None, training=True):\n",
        "        _, pred_noise_masks, noise_masks = y_pred\n",
        "        return self.loss(noise_masks, pred_noise_masks)\n",
        "\n",
        "    def generate(self, num_images, diffusion_steps):\n",
        "        # Partimos de ruido puro\n",
        "        noisy_images = keras.random.normal(\n",
        "            (num_images, self.image_size, self.image_size, 3), seed=self.seed_generator)\n",
        "        step_size = 1.0 / diffusion_steps\n",
        "        for step in range(diffusion_steps):\n",
        "            # Tasas de ruido y señal del paso actual\n",
        "            diffusion_times = ops.ones((num_images, 1, 1, 1)) - step * step_size\n",
        "            noise_rates, signal_rates = diffusion_schedule(diffusion_times)\n",
        "            # Llamamos al modelo de eliminación de ruido\n",
        "            pred_images, pred_noises = self.denoise(noisy_images, noise_rates, signal_rates)\n",
        "            # Preparamos la imagen ruidosa para la siguiente iteración (menos ruido)\n",
        "            next_diffusion_times = diffusion_times - step_size\n",
        "            next_noise_rates, next_signal_rates = diffusion_schedule(next_diffusion_times)\n",
        "            noisy_images = next_signal_rates * pred_images + next_noise_rates * pred_noises\n",
        "        # Desnormalizamos para volver a valores entre 0 y 255\n",
        "        images = self.normalizer.mean + pred_images * self.normalizer.variance ** 0.5\n",
        "        return ops.clip(images, 0.0, 255.0)"
      ]
