      "source": [
        "def slerp(t, v1, v2):\n",
        "    v1n, v2n = v1 / np.linalg.norm(v1), v2 / np.linalg.norm(v2)\n",
        "    omega = np.arccos(np.clip((v1n * v2n).sum(), -1, 1))\n",
        "    return (np.sin((1 - t) * omega) * v1 + np.sin(t * omega) * v2) / np.sin(omega)\n",
        "\n",
        "z = ops.convert_to_numpy(keras.random.normal((2, image_size, image_size, 3), seed=21))\n",
        "interp = np.stack([slerp(t, z[0], z[1]) for t in np.linspace(0, 1, 8)]).astype(\"float32\")\n",
        "show_images(generate_from_noise(ops.convert_to_tensor(interp), 20), n_cols=8, size=1.8,\n",
        "            title=\"Interpolación esférica entre dos ruidos iniciales\")"
      ]
    },
